<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SortingLab.App.ViewModels"
             x:Class="SortingLab.App.Controls.ExplanationCard"
             x:DataType="vm:StepPlaybackViewModelBase">
    <Border Classes="card" Padding="20,16" MinHeight="112">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="12" Height="12" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding StepBrush}" />
                <TextBlock Classes="label" Text="{Binding StepTitle}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="18" LineHeight="28" />
        </StackPanel>
    </Border>
</UserControl>