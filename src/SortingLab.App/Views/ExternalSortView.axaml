<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SortingLab.App.ViewModels"
             xmlns:ext="using:SortingLab.Core.External"
             xmlns:c="using:SortingLab.App.Controls"
             x:Class="SortingLab.App.Views.ExternalSortView"
             x:DataType="vm:ExternalSortViewModel"
             FontSize="14">
  <UserControl.Styles>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.legend">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,0,20,4" />
    </Style>
    <Style Selector="StackPanel.legend > TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="8,16,8,16" ColumnDefinitions="*,24,400" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <!-- Выбор метода, таблицы, ключевого поля и фильтра -->
    <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,10">
        <TextBlock Text="Метод" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <ComboBox Width="250" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="ext:IExternalSorter">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,10">
        <TextBlock Text="Примеры" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Content="Страны" Command="{Binding UseCountriesCommand}" />
        <Button Content="Вещества" Command="{Binding UseSubstancesCommand}" />
        <Button Content="Слова" Command="{Binding UseRussianWordsCommand}" />
        <Button Content="Открыть CSV…" Click="OnOpenCsvClick" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,10">
        <TextBlock Text="Поле сортировки" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <ComboBox Width="180" ItemsSource="{Binding Columns}" SelectedIndex="{Binding SelectedKeyColumnIndex}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <TextBlock Text="Фильтр" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <ComboBox Width="150" ItemsSource="{Binding FilterColumns}" SelectedIndex="{Binding SelectedFilterColumnIndex}" />
        <ComboBox Width="140" ItemsSource="{Binding FilterValues}" SelectedItem="{Binding SelectedFilterValue}"
                  IsEnabled="{Binding IsFilterValueEnabled}" />
      </StackPanel>
    </WrapPanel>

    <!-- Общая панель управления + кнопка сохранения результата -->
    <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Сохранить результат (CSV)…" Click="OnSaveResultClick"
              IsEnabled="{Binding HasSortedResult}" Margin="12,0,0,0" />
      <c:PlaybackBar />
    </DockPanel>

    <!-- Статус выбранной таблицы и файла результата -->
    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
      <TextBlock Classes="label" Text="{Binding TableStatus}" />
      <TextBlock Classes="meta" Text="{Binding OutputStatus}" VerticalAlignment="Center"
                 Foreground="{x:Static c:BarChart.SortedBrush}" />
    </StackPanel>

    <!-- Содержимое основного и вспомогательных файлов -->
    <Border Grid.Row="3" Grid.Column="0" Classes="card" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Tapes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TapeViewItem">
              <Border Background="{StaticResource PageBrush}" BorderBrush="{StaticResource HairlineBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="meta" Text="{Binding CountText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="title" Text="{Binding Name}" />
                      <TextBlock Classes="label" Text="{Binding Role}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>

                  <TextBlock Classes="meta" Text="Файл пуст" IsVisible="{Binding IsEmpty}" Margin="2,4" />

                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecordChipViewItem">
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                          <!-- Вертикальная черта показывает границу между сериями -->
                          <Border Width="2" Margin="2,4,8,4" CornerRadius="1"
                                  Background="{StaticResource TextMutedBrush}"
                                  IsVisible="{Binding ShowRunSeparator}" />
                          <Border Background="{Binding Background}"
                                  BorderBrush="{Binding BorderBrush}"
                                  BorderThickness="1.5"
                                  CornerRadius="6"
                                  Padding="10,6"
                                  Opacity="{Binding Opacity}"
                                  ToolTip.Tip="{Binding Tooltip}">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold" FontSize="14"
                                         Foreground="{Binding Foreground}" />
                              <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                         Foreground="{Binding Foreground}"
                                         IsVisible="{Binding HasSubtitle}" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Легенда -->
    <WrapPanel Grid.Row="4" Grid.Column="0" Margin="0,12,0,0">
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="#F4F4F5" BorderBrush="#D4D4D8" BorderThickness="1" />
        <TextBlock Text="Запись в файле" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.CompareBrush}" />
        <TextBlock Text="Сравниваем" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.MoveBrush}" />
        <TextBlock Text="Записали в файл" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.SortedBrush}" />
        <TextBlock Text="Отсортировано" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" Opacity="0.5" />
        <TextBlock Text="Уже прочитано" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Width="3" Height="12" CornerRadius="1" Background="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
        <TextBlock Text="Граница серий" />
      </StackPanel>
    </WrapPanel>

    <!-- Общая карточка пояснения для шестиклассника -->
    <c:ExplanationCard Grid.Row="5" Grid.Column="0" Margin="0,12,0,0" />

    <!-- Общая правая колонка: идея метода, счётчики, журнал -->
    <c:LogSidebar Grid.Row="3" Grid.RowSpan="3" Grid.Column="2" />
  </Grid>
</UserControl>