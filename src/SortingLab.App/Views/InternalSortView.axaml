<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SortingLab.App.ViewModels"
             xmlns:visual="using:SortingLab.Core.Visual"
             xmlns:c="using:SortingLab.App.Controls"
             x:Class="SortingLab.App.Views.InternalSortView"
             x:DataType="vm:InternalSortViewModel"
             FontSize="14">
  <UserControl.Styles>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.legend">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="0,0,20,4" />
    </Style>
    <Style Selector="StackPanel.legend > TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="8,16,8,16" ColumnDefinitions="*,24,400" RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- Исходный массив и выбор алгоритма -->
    <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,24,12">
        <TextBlock Text="Алгоритм" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <ComboBox Width="300" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="visual:IVisualSorter">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,24,12">
        <TextBlock Text="Размер" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <NumericUpDown Value="{Binding ArraySize}" Minimum="2" Maximum="40" Increment="1"
                       FormatString="0" Width="120" />
        <Button Content="Случайный массив" Command="{Binding GenerateRandomCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
        <TextBlock Text="Свой массив" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBox Text="{Binding CustomArray}" Width="320" Watermark="Например: 5 3 8 1 9 2" />
        <Button Content="Задать" Command="{Binding ApplyCustomCommand}" />
      </StackPanel>
    </WrapPanel>

    <!-- Общая панель управления и задержки -->
    <c:PlaybackBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16" />

    <!-- График на тетрадной клетке -->
    <Border Grid.Row="2" Grid.Column="0" Classes="card" ClipToBounds="True">
      <c:BarChart Frame="{Binding Frame}" Margin="8" MinHeight="260" />
    </Border>

    <!-- Легенда -->
    <WrapPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.NormalBrush}" />
        <TextBlock Text="Число в рабочей части" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.CompareBrush}" />
        <TextBlock Text="Сравниваем" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.MoveBrush}" />
        <TextBlock Text="Переставляем" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.PivotBrush}" />
        <TextBlock Text="Опорное число" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.HeldBrush}"
                BorderBrush="{x:Static c:BarChart.CompareBrush}" BorderThickness="1" />
        <TextBlock Text="Число «в руке»" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.SortedBrush}" />
        <TextBlock Text="Уже на своём месте" />
      </StackPanel>
      <StackPanel Classes="legend">
        <Border Classes="swatch" Background="{x:Static c:BarChart.FadedBrush}" />
        <TextBlock Text="Сейчас не участвует" />
      </StackPanel>
    </WrapPanel>

    <!-- Общая карточка пояснения -->
    <c:ExplanationCard Grid.Row="4" Grid.Column="0" Margin="0,12,0,0" />

    <!-- Общая правая колонка: описание, счётчики и журнал -->
    <c:LogSidebar Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" />
  </Grid>
</UserControl>